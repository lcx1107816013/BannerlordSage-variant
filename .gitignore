# Dependencies
node_modules/

# Generated runtime outputs
dist/
coverage/

# Logs
*.log

# Environment and local config
.env
.env.*

# Local databases and SQLite sidecars
#
# ★ An exception follows for the parity fixtures. Their SQLite databases ARE the expected
# values: the store and search_xml suites open them and compare against what the TypeScript
# recorded, so they must be committed. Without the negation below, `*.db` excludes them and
# those suites pass on the machine that generated them while failing on every fresh clone —
# and neither run would be lying. Same class of trap as a fixture under dist/.
*.db
!server-go/tools/parity/fixtures/*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local IDE / editor files
.idea/
.vs/
.vscode/
*.suo
*.user

# Local build outputs for bundled tools
tools/**/bin/
tools/**/obj/

# Internal notes that should not ship with the public repo
BANNERLORDSAGE_OPTIMIZATION_STATE.md

# Manual backups / editor leftovers (never ship these) — 2026-10-06
*.bak
*.bak_*
*.orig
*.tmp

# Scratch corpora for tools/rewrite-verify (rebuilt on every run)
tools/rewrite-verify/.tmp/
